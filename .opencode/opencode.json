{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "explabs": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Experiential Labs",
      "options": {
        "baseURL": "https://api.experientiallabs.ai/v1",
        "apiKey": "{env:EXPLABS_API_KEY}"
      },
      "models": {
        "gpt-6-astra": {
          "name": "gpt-6-astra",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "cost": {
            "input": 10,
            "output": 50
          }
        }
      }
    }
  }
}
