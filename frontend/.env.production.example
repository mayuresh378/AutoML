# ============================================================
# REQUIRED Vercel build-time environment variables (Vite frontend)
# ============================================================
# These are injected at BUILD time only (VITE_* prefix), so they MUST be set
# in the Vercel dashboard (Project -> Settings -> Environment Variables) for
# the Production environment. Committed .env files are gitignored and do NOT
# reach the Vercel build, which is why they must be configured on Vercel.
#
# Copy this file to frontend/.env (or frontend/.env.production) for LOCAL/dev
# builds only. Never commit real keys — use the Vercel dashboard for production.

# --- Base URL of the deployed FastAPI backend on Render ---
# Requests go directly to this URL and are NOT proxied through Vercel.
VITE_API_URL=https://automl-api.onrender.com/api/v1

# --- Firebase Web credentials (public — safe for the browser) ---
# From Firebase Console -> Project Settings -> General -> Your apps -> Web App.
# These are WEB client keys, NOT the Firebase Admin SDK service-account
# credentials. Never expose Admin SDK private keys anywhere in the frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
